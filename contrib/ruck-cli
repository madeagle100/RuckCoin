#!/bin/sh
# User-facing name for the RuckCoin RPC client. The binary is still raven-cli.
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -x "$DIR/../src/raven-cli" ]; then
  exec "$DIR/../src/raven-cli" "$@"
fi
if [ -x "$DIR/raven-cli" ]; then
  exec "$DIR/raven-cli" "$@"
fi
if [ -x /root/src/ruckcoin/src/raven-cli ]; then
  exec /root/src/ruckcoin/src/raven-cli "$@"
fi
echo "ruck-cli: raven-cli binary not found" >&2
exit 1
